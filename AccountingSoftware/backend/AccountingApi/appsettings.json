{
  "ConnectionStrings": {
    "accountingdb": "Server=(localdb)\\mssqllocaldb;Database=AccountingDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "AccountingApi",
    "Audience": "AccountingClient",
    "ExpirationMinutes": "60"
  },
  "AccountMapping": {
    "CashAccount": "1000",
    "AccountsReceivable": "1200",
    "Revenue": "4000",
    "SalesTaxPayable": "2300",
    "AccountsPayable": "2000",
    "Inventory": "1300",
    "CostOfGoodsSold": "5000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "OpenTelemetry"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "AccountingApi"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}